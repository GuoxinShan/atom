{
  "version": 1,
  "triggers": [
    {
      "id": "cli",
      "kind": "manual",
      "enabled": true,
      "pipeline": "run",
      "config": {}
    },
    {
      "id": "daily",
      "kind": "cron",
      "enabled": false,
      "pipeline": "run",
      "config": { "expr": "0 8 * * *" }
    },
    {
      "id": "inbound",
      "kind": "webhook",
      "enabled": false,
      "pipeline": "ingest",
      "config": { "path": "/hooks/atom" }
    },
    {
      "id": "yzj-hook",
      "kind": "im_event",
      "enabled": false,
      "pipeline": "ingest",
      "config": { "sourceId": "yzj" }
    },
    {
      "id": "on-ingested",
      "kind": "atom_event",
      "enabled": false,
      "pipeline": "extract",
      "config": { "type": "message_ingested", "auto": false }
    },
    {
      "id": "on-proposed",
      "kind": "atom_event",
      "enabled": false,
      "pipeline": "approve",
      "config": { "type": "candidate_proposed", "auto": false }
    }
  ]
}
