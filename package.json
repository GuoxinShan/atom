{
  "name": "atom",
  "private": true,
  "version": "0.1.0",
  "description": "ATOM — append-only demand feed with mandatory citations",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "atom": "tsx apps/cli/src/main.ts",
    "web": "tsx apps/web/src/server.ts",
    "serve": "tsx apps/web/src/server.ts",
    "typecheck": "pnpm -r run typecheck",
    "test": "tsx --test packages/core/src/agents/laya.test.ts packages/core/src/agents/preference-memory.test.ts packages/core/src/agents/grok-cli.test.ts packages/core/src/agents/resolve.test.ts packages/core/src/pipeline/laya-gates.test.ts packages/core/src/pipeline/merge-sweep.test.ts packages/core/src/pipeline/preference-rsi.test.ts packages/core/src/pipeline/gate-digest.test.ts packages/core/src/pipeline/cron-schedule.test.ts apps/web/src/desk.test.ts",
    "check:lead-routing": "tsx scripts/check-lead-routing.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
