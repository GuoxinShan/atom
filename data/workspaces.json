      "label": "Rocks-MacBook-Air",
      "hostname": "Rocks-MacBook-Air.local",
      "os": "darwin",
      "role": "secondary",
      "notes": "Do not assume repos exist here unless verified."
    },
    "rockspc": {
      "label": "rockspc",
      "hostname": "rockspc",
