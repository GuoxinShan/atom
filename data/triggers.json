{
  "triggers": [
    { "id": "manual-run", "kind": "manual", "enabled": true, "pipeline": "run" },
    {
      "id": "poll-yzj-15m",
      "kind": "cron",
      "enabled": true,
      "pipeline": "run",
      "name": "YZJ 15m poll",
      "config": {
        "everyMinutes": 15,
        "source": "yzj-ai-advance",
        "weekdaysOnly": true,
        "hoursLocal": [8, 20],
        "tz": "Asia/Shanghai",
        "includeRecentDms": true,
        "recentDmLimit": 8
      }
    },
    { "id": "webhook-ingest", "kind": "webhook", "enabled": false, "pipeline": "ingest", "config": { "path": "/hooks/ingest" } }
  ]
}
